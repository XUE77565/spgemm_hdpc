diff --git a/src/main.cu b/src/main.cu
index ad76a8e..9719ac2 100644
--- a/src/main.cu
+++ b/src/main.cu
@@ -1,5 +1,6 @@
 #include <iostream>
 #include <fstream>
+#include <chrono>
 #include <cuda_runtime.h>
 #include <cub/cub.cuh>
 #include "SpGEMM.cuh"
@@ -60,11 +61,45 @@ int main(int argc, char** argv) {
 
     somespgemm::SpGEMM spgemm{config};
 
+    // ROWCYCLES=path:hashNumeric 逐行周期采数(对拍我方 HASH_ROWTIME;末次迭代值)
+    unsigned long long *d_row_cycles = nullptr;
+    const char *rowcycles_path = std::getenv("ROWCYCLES");
+    if (rowcycles_path && *rowcycles_path) {
+        cudaMalloc(&d_row_cycles, sizeof(unsigned long long) * matrix_a->rows);
+        cudaMemset(d_row_cycles, 0, sizeof(unsigned long long) * matrix_a->rows);
+        cudaMemcpyToSymbol(somespgemm::g_row_cycles, &d_row_cycles, sizeof(d_row_cycles));
+        std::cerr << "[ROWCYCLES] armed " << matrix_a->rows << " rows -> " << rowcycles_path << std::endl;
+    }
+
+    // ★ 加 H2D/D2H 计时(对比端到端用)
+    cudaFree(0); cudaDeviceSynchronize();   // 预热 CUDA context,排除冷启动开销
+    auto _t0 = std::chrono::high_resolution_clock::now();
     auto d_A = std::make_shared<somespgemm::cuCSR>(*matrix_a);
     auto d_B = std::make_shared<somespgemm::cuCSR>(*matrix_b);
+    cudaDeviceSynchronize();
+    auto _t1 = std::chrono::high_resolution_clock::now();
 
     auto result = spgemm.run(d_A, d_B);
+
+    auto _t2 = std::chrono::high_resolution_clock::now();
     auto result_host = std::make_shared<somespgemm::CSR>(*result);
+    cudaDeviceSynchronize();
+    auto _t3 = std::chrono::high_resolution_clock::now();
+
+    double _h2d = std::chrono::duration<double, std::milli>(_t1 - _t0).count();
+    double _d2h = std::chrono::duration<double, std::milli>(_t3 - _t2).count();
+    std::cout << "H2D_time: " << _h2d << " ms" << std::endl;
+    std::cout << "D2H_time: " << _d2h << " ms" << std::endl;
+
+    if (d_row_cycles && rowcycles_path && *rowcycles_path) {
+        std::vector<unsigned long long> h_rc(matrix_a->rows);
+        cudaMemcpy(h_rc.data(), d_row_cycles, sizeof(unsigned long long) * matrix_a->rows, cudaMemcpyDeviceToHost);
+        std::ofstream rf(rowcycles_path);
+        for (long long r = 0; r < (long long)matrix_a->rows; r++)
+            if (h_rc[r]) rf << r << " " << h_rc[r] << "\n";
+        rf.close();
+        std::cerr << "[ROWCYCLES] dumped -> " << rowcycles_path << std::endl;
+    }
 
     if (config.check_correctness) {
         auto ground_truth = somespgemm::loadMatrix(config.ground_truth_file);
